# M365 MCP Server - Environment Configuration Example
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED - Microsoft Authentication
# ============================================================================

# Azure App Registration Client ID (required)
# Get this from Azure Portal → App Registrations → Your App → Application (client) ID
M365_MCP_CLIENT_ID=your-app-client-id-here

# Azure Tenant ID (optional, defaults to "consumers")
# Only personal Microsoft accounts (outlook.com, hotmail.com, live.com)
# are supported; work/school sign-ins are rejected.
# M365_MCP_TENANT_ID=consumers

# Interactive auth is disabled during normal MCP requests so tool calls do not
# block waiting for device-code input. `uv run authenticate.py` enables this
# explicitly for the standalone authentication flow.
# M365_MCP_INTERACTIVE_AUTH=false

# ============================================================================
# TOOL SURFACE
# ============================================================================

# Tool tiers to register (comma separated). Default: core,extended (23 tools).
# - core:     16 tools (m365_list/get/search/get_content/create/update/move/
#             delete, email_create_draft/send/reply/forward,
#             calendar_create_event/update_event/respond/find_availability)
# - extended:  7 tools (drive_upload/copy/share, email_folder_mark_all_read,
#             email_folder_empty, email_rule_manage, calendar_forward)
# - admin:     7 tools (account_list, account_auth_begin/complete,
#             admin_cache_get, admin_cache_invalidate, admin_server_info,
#             admin_reauth_schedule)
# Use "core" for clients without tool search; add "admin" to sign in or
# inspect the cache from the client. Unknown values fail at startup.
# M365_MCP_TOOLSETS=core,extended

# Weekly re-authentication (optional). A personal account's refresh token
# expires after 90 days without use. With MCP_WEEKLY_RE_AUTH=true the server
# installs a weekly job (Windows Task Scheduler, or cron on Linux and macOS)
# that force-refreshes every signed-in account, and re-checks it every
# MCP_RE_AUTH_CHECK_HOURS: it reinstalls a missing or changed job and logs a
# warning if a run failed or is overdue. "false" removes the job; unset leaves
# any existing job alone. The admin tool admin_reauth_schedule (admin tier)
# shows its status and can install or remove it. The job runs
# `python -m m365_mcp.reauth_job` and records its result in
# ~/.m365_mcp_reauth_state.json (log: ~/.m365_mcp_reauth.log).
# MCP_WEEKLY_RE_AUTH=true
# MCP_RE_AUTH_DAY=Sunday
# MCP_RE_AUTH_TIME=09:00
# MCP_RE_AUTH_CHECK_HOURS=6

# HMAC key that protects pagination cursors (optional). If unset, a random key
# is generated for each server process, so cursors stop working after a
# restart (the model simply repeats the call without a cursor). Set a long
# random value (for example `openssl rand -hex 32`) to keep cursors valid
# across restarts or several workers. Treat it as a secret.
# M365_MCP_CURSOR_KEY=

# Validate every tool result against its outputSchema before returning it
# (1/true/yes/on, anything else for off). Off by default; on automatically
# while pytest runs, so tests still catch a broken contract. Turning it on
# in production adds a validation pass to every call: use it only to debug
# a schema mismatch.
# M365_MCP_VALIDATE_OUTPUT=false

# ============================================================================
# LOCAL FILE ACCESS
# ============================================================================

# Local files may be read (drive_upload) or written (m365_get_content) only
# inside the working directory, the system temp directory and the folders
# listed here (separated by ";" on Windows, ":" elsewhere). Hidden files
# (names starting with "."), *.pem, *.key and token caches are always refused.
# MCP_FILE_ALLOWED_ROOTS=C:/Users/you/Downloads;C:/Users/you/Documents

# Largest OneDrive file the server will download, in MiB (default: 512)
# MCP_FILE_DOWNLOAD_MAX_MB=512

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

# Cache database path (default: ~/.m365_mcp_cache.db)
# M365_MCP_CACHE_DB_PATH=~/.m365_mcp_cache.db

# Durable base64-encoded 32-byte cache encryption key for headless services.
# If unset, the server tries the system keyring, then generates a key. A
# generated key that cannot be stored durably is logged as ephemeral.
# M365_MCP_CACHE_KEY=

# Enable background startup warming and stale-cache refresh tasks.
# Default false keeps cache population on demand only.
# M365_MCP_CACHE_WARMING=false

# ============================================================================
# TRANSPORT MODE - Choose stdio (default) or Streamable HTTP
# ============================================================================

# Transport mode: "stdio" or "http"
# - stdio: Default, for desktop apps like Claude Desktop (secure via process isolation)
# - http: Streamable HTTP for web/API access (MCP spec 2025-03-26+, requires authentication)
# MCP_TRANSPORT=stdio

# ============================================================================
# HTTP TRANSPORT CONFIGURATION (only used if MCP_TRANSPORT=http)
# ============================================================================

# HTTP Server Host (default: 127.0.0.1)
# Use 127.0.0.1 for localhost only (recommended)
# Use 0.0.0.0 to bind to all network interfaces (requires firewall configuration)
# MCP_HOST=127.0.0.1

# HTTP Server Port (default: 8000)
# MCP_PORT=8000

# MCP Endpoint Path (default: /mcp)
# The path where the Streamable HTTP endpoint is mounted
# MCP_PATH=/mcp

# ============================================================================
# HTTP AUTHENTICATION (required if MCP_TRANSPORT=http)
# ============================================================================

# Authentication Method: "bearer" or "none"
# - bearer: Token-based auth (recommended); compared in constant time
# - none: No authentication (DANGEROUS - requires MCP_ALLOW_INSECURE=true)
# "oauth" and any other value are not supported and fail at startup.
# MCP_AUTH_METHOD=bearer

# Bearer Token (required if MCP_AUTH_METHOD=bearer)
# Generate a secure token with: openssl rand -hex 32
# Minimum 32 characters recommended
# MCP_AUTH_TOKEN=your-secure-token-here

# Allowed browser Origins (comma separated, exact scheme://host[:port]).
# Requests that carry an Origin header not listed here are rejected (protects
# against DNS rebinding). Default: http(s) on localhost, 127.0.0.1 and [::1].
# Requests without an Origin header (desktop and CLI clients) are unaffected.
# Setting this replaces the loopback default.
# MCP_ALLOWED_ORIGINS=https://app.example.com

# Allow Insecure HTTP Server (default: false)
# Set to "true" to allow HTTP without authentication (NOT RECOMMENDED)
# Only use for local development on isolated networks
# WARNING: Anyone who can reach the server will have full access to your Microsoft account!
# MCP_ALLOW_INSECURE=false

# ============================================================================
# EXAMPLE CONFIGURATIONS
# ============================================================================

# Example 1: stdio mode (default) - For Claude Desktop
# M365_MCP_CLIENT_ID=abc123-def456-ghi789
# MCP_TRANSPORT=stdio

# Example 2: Streamable HTTP mode with bearer token authentication
# M365_MCP_CLIENT_ID=abc123-def456-ghi789
# MCP_TRANSPORT=http
# MCP_AUTH_METHOD=bearer
# MCP_AUTH_TOKEN=$(openssl rand -hex 32)
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp

# Example 3: Streamable HTTP mode - Insecure (testing only - NOT RECOMMENDED)
# M365_MCP_CLIENT_ID=abc123-def456-ghi789
# MCP_TRANSPORT=http
# MCP_AUTH_METHOD=none
# MCP_ALLOW_INSECURE=true
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp

# ============================================================================
# SECURITY NOTES
# ============================================================================
#
# 1. NEVER commit .env file to version control
#    - Add .env to .gitignore (already configured)
#
# 2. Generate secure tokens:
#    - openssl rand -hex 32    # 64-character hex token
#    - python3 -c "import uuid; print(uuid.uuid4())"  # UUID token
#
# 3. Rotate tokens regularly in production
#
# 4. Use secrets managers for production:
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Azure Key Vault
#
# 5. For Streamable HTTP mode:
#    - Always use authentication (bearer)
#    - Prefer localhost binding (127.0.0.1)
#    - Use SSH tunneling for remote access instead of 0.0.0.0
#    - Put behind reverse proxy (nginx/Caddy) for TLS/HTTPS
#
# 6. stdio mode is secure by default (no additional auth needed)
#
# For complete security guide, see SECURITY.md
# For setup instructions, see QUICKSTART.md
