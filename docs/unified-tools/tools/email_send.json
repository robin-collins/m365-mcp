{
  "spec_version": "1.0.0",
  "name": "email_send",
  "title": "Send Email",
  "description": "Send an email now: a new message (mode='new') or a draft you created earlier (mode='draft'). Requires confirm=true after the user approves the recipients and content. Cannot be undone. Never infer recipients.",
  "annotations": {
    "title": "Send Email",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": true
  },
  "meta": {
    "category": "email",
    "tier": "core",
    "safety_level": "dangerous",
    "confirm": "always",
    "confirm_rule": "Always required."
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "new",
          "draft"
        ],
        "description": "Send a new message or an existing draft."
      },
      "account_id": {
        "type": "string",
        "description": "Account ID or email address. Omit when only one account is signed in.",
        "minLength": 1,
        "maxLength": 320
      },
      "to": {
        "type": "array",
        "description": "Recipients (To).",
        "items": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 320,
          "description": "Email address, e.g. jane@example.com."
        },
        "maxItems": 500,
        "uniqueItems": true,
        "minItems": 1
      },
      "cc": {
        "type": "array",
        "description": "Cc recipients.",
        "items": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 320,
          "description": "Email address, e.g. jane@example.com."
        },
        "maxItems": 500,
        "uniqueItems": true
      },
      "bcc": {
        "type": "array",
        "description": "Bcc recipients.",
        "items": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 320,
          "description": "Email address, e.g. jane@example.com."
        },
        "maxItems": 500,
        "uniqueItems": true
      },
      "subject": {
        "type": "string",
        "description": "Subject line.",
        "minLength": 1,
        "maxLength": 998
      },
      "body": {
        "type": "string",
        "description": "Message body.",
        "maxLength": 1000000
      },
      "body_format": {
        "type": "string",
        "enum": [
          "text",
          "html"
        ],
        "description": "Format of the body text you supply.",
        "default": "text"
      },
      "attachments": {
        "type": "array",
        "description": "Local files to attach: at most 10, each at most 25 MB.",
        "items": {
          "type": "string",
          "description": "Local file path inside the server's allowed folders. Hidden and secret files are refused.",
          "minLength": 1,
          "maxLength": 4096
        },
        "maxItems": 10,
        "uniqueItems": true
      },
      "importance": {
        "type": "string",
        "enum": [
          "low",
          "normal",
          "high"
        ],
        "description": "Message importance."
      },
      "save_to_sent": {
        "type": "boolean",
        "description": "mode='new': keep a copy in Sent Items.",
        "default": true
      },
      "draft_id": {
        "type": "string",
        "description": "mode='draft': draft ID from email_create_draft.",
        "minLength": 1,
        "maxLength": 1024
      },
      "confirm": {
        "type": "boolean",
        "description": "Must be true to send this email; set only after the user approves.",
        "default": false
      }
    },
    "required": [
      "mode",
      "confirm"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "Send confirmation.",
    "properties": {
      "status": {
        "const": "sent"
      },
      "mode": {
        "enum": [
          "new",
          "draft"
        ]
      },
      "draft_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "recipient_count": {
        "type": "integer",
        "minimum": 0
      },
      "sent_at": {
        "type": "string",
        "format": "date-time"
      },
      "summary": {
        "type": "string",
        "description": "One-line human summary; also returned as the text content."
      }
    },
    "required": [
      "status",
      "mode",
      "draft_id",
      "recipient_count",
      "sent_at",
      "summary"
    ],
    "additionalProperties": false
  },
  "graph_calls": [
    "new without attachments ≥ 3 MB: POST /me/sendMail {message, saveToSentItems}",
    "new with large attachments: POST /me/messages → upload sessions → POST /me/messages/{id}/send",
    "draft: POST /me/messages/{draft_id}/send"
  ],
  "validation_rules": [
    {
      "rule": "mode='new' requires to, subject and body; mode='draft' requires draft_id and forbids message fields.",
      "error": "Invalid draft_id: required when mode='draft'"
    },
    {
      "rule": "confirm must be true.",
      "error": "Invalid confirm 'False': send email requires confirm=True to proceed. Expected: Explicit user confirmation"
    },
    {
      "rule": "Never retried after a timeout or ambiguous 5xx.",
      "error": "Outcome unknown: check Sent Items before retrying"
    }
  ],
  "replaces": [
    "email_send"
  ],
  "examples": [
    {
      "title": "Send a reviewed draft",
      "input": {
        "mode": "draft",
        "draft_id": "AQMkADAwATM3ZmYAZS1kDRFT",
        "confirm": true
      },
      "output": {
        "status": "sent",
        "mode": "draft",
        "draft_id": "AQMkADAwATM3ZmYAZS1kDRFT",
        "recipient_count": 1,
        "sent_at": "2026-09-26T10:05:00+09:30",
        "summary": "Sent 'Weekend' to 1 recipient."
      }
    }
  ]
}
