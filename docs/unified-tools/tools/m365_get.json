                "type": "null"
              }
            ]
          },
          "address": {
            "type": "string"
          },
          "type": {
            "enum": [
              "required",
              "optional",
              "resource"
            ]
          },
          "response": {
            "enum": [
              "none",
              "organizer",
              "tentativelyAccepted",
              "accepted",
              "declined",
              "notResponded"
            ]
          }
        },
        "required": [
          "name",
          "address",
          "type",
          "response"
        ],
        "additionalProperties": false
