{
  "spec_version": "1.0.0",
  "name": "m365_get",
  "title": "Get Item",
  "description": "Read one item whose ID you already have: an email with its body, an event with attendees, a contact, a mail or contact folder, an inbox rule, a calendar, a OneDrive item's details, or the status of a copy started with drive_copy (resource='operation'). Use m365_list or m365_search to find IDs. Use m365_get_content to download files or attachments. Returns the item.",
  "annotations": {
    "title": "Get Item",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "meta": {
    "category": "m365",
    "tier": "core",
    "safety_level": "safe",
    "confirm": "never",
    "confirm_rule": null
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "resource": {
        "type": "string",
        "enum": [
          "email",
          "email_folder",
          "email_rule",
          "event",
          "calendar",
          "contact",
          "contact_folder",
          "drive_item",
          "operation"
        ],
        "description": "Type of item."
      },
      "account_id": {
        "type": "string",
        "description": "Account ID or email address. Omit when only one account is signed in.",
        "minLength": 1,
        "maxLength": 320
      },
      "id": {
        "type": "string",
        "description": "Item ID from a previous result (for operation: the operation_id). Aliases are accepted for email_folder, calendar (default) and drive_item (root).",
        "minLength": 1,
        "maxLength": 1024
      },
      "path": {
        "type": "string",
        "description": "drive_item only: OneDrive path instead of id.",
        "minLength": 1,
        "maxLength": 2048
      },
      "include_body": {
        "type": "boolean",
        "description": "email and event: include the body text.",
        "default": true
      },
      "body_max_chars": {
        "type": "integer",
        "description": "email and event: truncate the body after this many characters.",
        "minimum": 500,
        "maximum": 100000,
        "default": 20000
      },
      "refresh": {
        "type": "boolean",
        "description": "Bypass the cache and fetch fresh data.",
        "default": false
      }
    },
    "required": [
      "resource"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "The requested item.",
    "properties": {
      "resource": {
        "enum": [
          "email",
          "email_folder",
          "email_rule",
          "event",
          "calendar",
          "contact",
          "contact_folder",
          "drive_item",
          "operation"
        ]
      },
      "item": {
        "anyOf": [
          {
            "$ref": "#/$defs/email_detail"
          },
          {
            "$ref": "#/$defs/email_folder"
          },
          {
            "$ref": "#/$defs/email_rule"
          },
          {
            "$ref": "#/$defs/event_detail"
          },
          {
            "$ref": "#/$defs/calendar"
          },
          {
            "$ref": "#/$defs/contact"
          },
          {
            "$ref": "#/$defs/contact_folder"
          },
          {
            "$ref": "#/$defs/drive_item"
          },
          {
            "$ref": "#/$defs/operation"
          }
        ]
      },
      "summary": {
        "type": "string",
        "description": "One-line human summary; also returned as the text content."
      }
    },
    "required": [
      "resource",
      "item",
      "summary"
    ],
    "additionalProperties": false,
    "$defs": {
      "attachment_meta": {
        "type": "object",
        "description": "Email attachment metadata (content via m365_get_content).",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "content_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_inline": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "size",
          "content_type",
          "is_inline"
        ],
        "additionalProperties": false
      },
      "attendee": {
        "type": "object",
        "description": "Event attendee and their response.",
