{
  "spec_version": "1.0.0",
  "name": "m365_list",
  "title": "List Items",
  "description": "Browse items of one type in a known place: emails in a mail folder, events in a time window, calendars, contacts, contact folders, mail folders, inbox rules, or files in a OneDrive folder (optionally as a tree). Use this when you know where to look. Use m365_search to find items by text, and m365_get when you already have an ID. Returns compact items plus next_cursor for more.",
  "annotations": {
    "title": "List Items",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "meta": {
    "category": "m365",
    "tier": "core",
    "safety_level": "safe",
    "confirm": "never",
    "confirm_rule": null
  },
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "resource": {
        "type": "string",
        "enum": [
          "email",
          "email_folder",
          "email_rule",
          "event",
          "calendar",
          "contact",
          "contact_folder",
          "drive_item"
        ],
        "description": "Type of item to list."
      },
      "account_id": {
        "type": "string",
        "description": "Account ID or email address. Omit when only one account is signed in.",
        "minLength": 1,
        "maxLength": 320
      },
      "container_id": {
        "type": "string",
        "description": "Where to list. email: mail folder ID or alias (default inbox). email_folder: parent folder (default: top level). event: calendar ID (default: your default calendar). contact: contact folder ID (default: all contacts). drive_item: parent folder ID (default: OneDrive root). Not used for calendar, contact_folder and email_rule.",
        "minLength": 1,
        "maxLength": 1024
      },
      "path": {
        "type": "string",
        "description": "drive_item only: OneDrive folder path instead of container_id, e.g. /Documents/Tax.",
        "minLength": 1,
        "maxLength": 2048
      },
      "email_filter": {
        "type": "object",
        "description": "email only: filters applied by Microsoft 365 (all must match).",
        "properties": {
          "unread": {
            "type": "boolean",
            "description": "Only unread (true) or only read (false)."
          },
          "from": {
            "type": "string",
            "format": "email",
            "minLength": 3,
            "maxLength": 320,
            "description": "Email address, e.g. jane@example.com."
          },
          "received_after": {
            "type": "string",
            "description": "RFC 3339 date-time with offset, e.g. 2026-10-01T09:00:00+09:30.",
            "format": "date-time"
          },
          "received_before": {
            "type": "string",
            "description": "RFC 3339 date-time with offset, e.g. 2026-10-01T09:00:00+09:30.",
            "format": "date-time"
          },
          "has_attachments": {
            "type": "boolean",
            "description": "Only messages with attachments."
          },
          "importance": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high"
            ],
            "description": "Message importance."
          },
          "flagged": {
            "type": "boolean",
            "description": "Only flagged messages."
          },
          "category": {
            "type": "string",
            "description": "Only messages with this category.",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false,
        "minProperties": 1
      },
      "start": {
        "type": "string",
        "description": "event only: window start (default now). RFC 3339 with offset.",
        "format": "date-time"
      },
      "end": {
        "type": "string",
        "description": "event only: window end (default start + 7 days; at most 366 days after start).",
        "format": "date-time"
      },
      "item_type": {
        "type": "string",
        "enum": [
          "file",
          "folder",
          "all"
        ],
        "description": "drive_item only: which kinds of item to return.",
        "default": "all"
      },
      "recursive": {
        "type": "boolean",
        "description": "email_folder and drive_item only: return a nested tree of folders instead of one level.",
        "default": false
      },
      "max_depth": {
        "type": "integer",
        "description": "Tree depth when recursive=true.",
        "minimum": 1,
        "maximum": 10,
        "default": 3
      },
      "include_hidden": {
        "type": "boolean",
        "description": "email_folder only: include hidden folders.",
        "default": false
      },
      "limit": {
        "type": "integer",
        "description": "Maximum number of items to return.",
        "minimum": 1,
        "maximum": 50,
        "default": 20
      },
      "cursor": {
        "type": "string",
        "description": "next_cursor from the previous page; keep all other arguments the same.",
        "minLength": 1,
        "maxLength": 8192
      },
      "refresh": {
        "type": "boolean",
        "description": "Bypass the cache and fetch fresh data.",
        "default": false
      }
    },
    "required": [
      "resource"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "Page of items of the requested resource type.",
    "properties": {
      "resource": {
        "enum": [
          "email",
          "email_folder",
          "email_rule",
          "event",
          "calendar",
          "contact",
          "contact_folder",
          "drive_item"
        ]
      },
      "items": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/email_summary"
            },
            {
              "$ref": "#/$defs/email_folder"
            },
            {
              "$ref": "#/$defs/email_rule"
            },
            {
              "$ref": "#/$defs/event_summary"
            },
            {
              "$ref": "#/$defs/calendar"
            },
            {
              "$ref": "#/$defs/contact"
            },
            {
              "$ref": "#/$defs/contact_folder"
            },
            {
              "$ref": "#/$defs/drive_item"
            }
          ]
        }
      },
      "next_cursor": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "has_more": {
        "type": "boolean"
      },
      "summary": {
        "type": "string",
        "description": "One-line human summary; also returned as the text content."
      }
    },
    "required": [
      "resource",
      "items",
      "next_cursor",
      "has_more",
      "summary"
    ],
    "additionalProperties": false,
